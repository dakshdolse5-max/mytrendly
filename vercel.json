{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "(?<pid>\\d+)"
        }
      ],
      "destination": "/api/page.js?kind=product&slug=:pid"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "coupon",
          "value": "(?<cid>\\d+)"
        }
      ],
      "destination": "/api/page.js?kind=coupon&slug=:cid"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "trending",
          "value": "(?<tid>\\d+)"
        }
      ],
      "destination": "/api/article.js?slug=:tid"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml.js"
    },
    {
      "source": "/api/sitemap.xml",
      "destination": "/api/sitemap.xml.js"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/llms.js"
    },
    {
      "source": "/coupons",
      "destination": "/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/index.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/index.html"
    },
    {
      "source": "/terms-of-use",
      "destination": "/index.html"
    },
    {
      "source": "/affiliate-disclosure",
      "destination": "/index.html"
    },
    {
      "source": "/cookie-policy",
      "destination": "/index.html"
    },
    {
      "source": "/dpdp-act-compliance",
      "destination": "/index.html"
    },
    {
      "source": "/about-us",
      "destination": "/index.html"
    },
    {
      "source": "/contact-us",
      "destination": "/index.html"
    },
    {
      "source": "/report-ip-infringement",
      "destination": "/index.html"
    },
    {
      "source": "/data-and-compliance",
      "destination": "/index.html"
    },
    {
      "source": "/data-security",
      "destination": "/index.html"
    },
    {
      "source": "/your-rights",
      "destination": "/index.html"
    },
    {
      "source": "/returns-refunds-shipping",
      "destination": "/index.html"
    },
    {
      "source": "/how-we-review",
      "destination": "/index.html"
    },
    {
      "source": "/site-map",
      "destination": "/index.html"
    },
    {
      "source": "/article/:slug",
      "destination": "/api/article.js?slug=:slug"
    },
    {
      "source": "/product/:slug",
      "destination": "/api/page.js?kind=product&slug=:slug"
    },
    {
      "source": "/coupon/:slug",
      "destination": "/api/page.js?kind=coupon&slug=:slug"
    }
  ],
  "functions": {
    "api/article.js": {
      "includeFiles": "index.html"
    },
    "api/page.js": {
      "includeFiles": "index.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|ico|svg|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}