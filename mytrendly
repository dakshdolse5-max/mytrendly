    const p = products.find(x => x.id === dealOfDay);
    if(!p) {
        c.innerHTML = '<p style="text-align:center;color:var(--gray);padding:40px;">Deal product details offline.</p>';
        return;
    }

    const imgs = Array.isArray(p.images) && p.images.length ? p.images : [{url: placeholderImage}];
    dealImageIndex = 0;
    const firstImg = escapeHtml(safeUrl(imgs[0]?.url, placeholderImage));

    const controls = imgs.length > 1 ? `
        <button type="button" class="deal-slide-btn prev" onclick="changeDealImage(-1)"><i class="fas fa-chevron-left"></i></button>
        <button type="button" class="deal-slide-btn next" onclick="changeDealImage(1)"><i class="fas fa-chevron-right"></i></button>
        <div class="deal-slide-dots">${imgs.map((_,i)=>`<button type="button" class="deal-slide-dot ${i===0?'active':''}" onclick="changeDealImage(${i},true)"></button>`).join('')}</div>` : '';

    c.innerHTML = `<div class="deal-card">
        <div class="deal-img">
            <div class="deal-slideshow">
                <img id="dealImage" src="${firstImg}" alt="${escapeHtml(p.name)}" onerror="this.src='${placeholderImage}'">
                ${controls}
            </div>
        </div>
        <div class="deal-info">
            <div class="deal-tag"><i class="fas fa-fire"></i> DEAL OF THE DAY</div>
            <h2>${escapeHtml(p.name)}</h2>
            <div class="product-price" style="margin:15px 0;"><span class="price-range" style="font-size:28px;">${escapeHtml(p.price_range)}</span></div>
            <div class="deal-countdown">
                <p>⏰ Hurry! Deal ends in:</p>
                <div class="deal-timer">
                    <div class="deal-timer-item"><span class="num" id="dH">00</span><span class="lbl">HRS</span></div>
                    <div class="deal-timer-item"><span class="num" id="dM">00</span><span class="lbl">MIN</span></div>
                    <div class="deal-timer-item"><span class="num" id="dS">00</span><span class="lbl">SEC</span></div>
                </div>
            </div>
            <a id="dealBuyLink" href="${escapeHtml(p.affiliate_url)}" target="_blank" rel="noopener noreferrer nofollow" class="btn-buy" style="max-width:280px;" onclick="trackClick(${p.id}, '${escapeHtml(p.name)}')">
                <i class="fas fa-external-link-alt"></i> Check Deal
            </a>
        </div>
    </div>`;

    function updateTimer() {
        const end = dealEndTime ? new Date(dealEndTime) : new Date(new Date().setHours(23, 59, 59));
        const diff = end - new Date();
        if(diff <= 0) return;
        document.getElementById('dH').textContent = String(Math.floor(diff / 36e5)).padStart(2, '0');
        document.getElementById('dM').textContent = String(Math.floor(diff % 36e5 / 6e4)).padStart(2, '0');
        document.getElementById('dS').textContent = String(Math.floor(diff % 6e4 / 1e3)).padStart(2, '0');
    }
    updateTimer();
    dealTimerInterval = setInterval(updateTimer, 1000);
}

function changeDealImage(val, isIndex = false) {
    const p = products.find(x => x.id === dealOfDay);
    if (!p) return;
    const imgs = p.images || [];
    dealImageIndex = isIndex ? val : (dealImageIndex + val + imgs.length) % imgs.length;
    document.getElementById('dealImage').src = imgs[dealImageIndex]?.url || placeholderImage;
    document.querySelectorAll('.deal-slide-dot').forEach((d, i) => d.classList.toggle('active', i === dealImageIndex));
}

