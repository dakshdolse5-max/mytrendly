async function addProduct() {
    const name = document.getElementById('prodName').value.trim();
    const cat = document.getElementById('prodCategory').value;
    const pr = document.getElementById('prodPriceRange').value.trim();
    const affiliateUrl = document.getElementById('prodAffiliateUrl').value.trim();
    const badge = document.getElementById('prodBadge').value;
    const coupon = document.getElementById('prodCoupon').value;
    const fileInput = document.getElementById('prodImageFiles');

    if(!name || !cat || !pr) {
        showToast('Fill in all required fields!', 'error');
        return;
    }

    showToast('Saving Product...', 'info');
    let imgs = [];

    // Parse manually entered image URLs
    document.querySelectorAll('#imageUrlsContainer .img-url-input').forEach(input => {
        const url = input.value.trim();
        if(url) imgs.push({ url, affiliateUrl });
    });

    // Handle Supabase File Storage Upload option
    if(fileInput && fileInput.files.length) {
        for(let i=0; i < fileInput.files.length; i++) {
            const uploadedUrl = await uploadToSupabaseStorage(fileInput.files[i], 'products');
            if(uploadedUrl) imgs.push({ url: uploadedUrl, affiliateUrl });
        }
    }

    if(!imgs.length) imgs.push({ url: placeholderImage, affiliateUrl });

    const { error } = await _supabase.from('products').insert({
        name, category: cat, price_range: pr, badge, affiliate_url: affiliateUrl, images: imgs
    });

    if(error) {
        showToast('Database error: ' + error.message, 'error');
    } else {
        showToast('Product deployed dynamically! 🎉', 'success');
        document.getElementById('prodName').value = '';
        document.getElementById('prodPriceRange').value = '';
        document.getElementById('prodAffiliateUrl').value = '';
        fileInput.value = '';
        document.getElementById('imageUrlsContainer').innerHTML = '<div class="image-url-row"><input type="text" placeholder="Image URL (paste image link)" class="img-url-input"><button class="btn-remove-url" onclick="this.parentElement.remove()">&times;</button></div>';
        await syncFromSupabase();
    }
}

