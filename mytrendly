// ===== REAL-TIME BULK IMPORT ENGINE =====
async function bulkUpload(e) {
    const file = e.target.files[0];
    if(!file) return;
    
    const reader = new FileReader();
    reader.onload = async (ev) => {
        try {
            const data = JSON.parse(ev.target.result);
            if(!Array.isArray(data)) {
                showToast('Format error: JSON must be an array of products', 'error');
                return;
            }

            showToast('Bulk uploading to Supabase...', 'info');
            const insertPayload = data.map(item => ({
                name: item.name,
                category: item.category,
                price_range: item.priceRange || 'Price not available',
                badge: item.badge || '',
                affiliate_url: item.affiliateUrl || '#',
                images: Array.isArray(item.images) ? item.images : [{ url: placeholderImage }]
            }));

            const { error } = await _supabase.from('products').insert(insertPayload);
            if(error) throw error;

            showToast(`Bulk upload finished! Imported ${data.length} products.`, 'success');
            await syncFromSupabase();
        } catch(err) {
            showToast('JSON validation error: ' + err.message, 'error');
        }
    };
    reader.readAsText(file);
    e.target.value = '';
}

