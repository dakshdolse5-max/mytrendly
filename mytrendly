// ===== FLASH SALE TICKER =====
function startCountdown() {
    function u() {
        const n = new Date(), e = new Date(n);
        e.setHours(23, 59, 59, 999);
        if (e <= n) e.setDate(e.getDate() + 1);
        const d = e - n;
        document.getElementById('hours').textContent = String(Math.floor(d / 36e5)).padStart(2, '0');
        document.getElementById('minutes').textContent = String(Math.floor(d % 36e5 / 6e4)).padStart(2, '0');
        document.getElementById('seconds').textContent = String(Math.floor(d % 6e4 / 1e3)).padStart(2, '0');
    }
    u();
    setInterval(u, 1000);
}

// ===== RENDER ACTIVE PRODUCTS =====
function renderProducts(list) {
    const g = document.getElementById('productsGrid');
    const display = list || getFilteredProducts();
    document.getElementById('productsCount').textContent = `${display.length} products found`;
    
    if (!display.length) {
        g.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:60px 20px;"><i class="fas fa-search" style="font-size:50px;color:var(--gray);margin-bottom:15px;display:block;"></i><h3 style="color:var(--gray);">No products found</h3></div>`;
        return;
    }

    g.innerHTML = display.map(p => {
        const pid = Number(p.id);
        const inW = wishlist.includes(pid);
        const imgs = Array.isArray(p.images) && p.images.length ? p.images : [{url: placeholderImage}];
        const firstImg = escapeHtml(safeUrl(imgs[0]?.url, placeholderImage));
        const affiliateUrl = escapeHtml(safeUrl(p.affiliate_url || imgs[0]?.affiliateUrl));
        const badge = p.badge && allowedBadges.includes(p.badge) ? `<span class="product-badge badge-${p.badge}">${p.badge.toUpperCase()}</span>` : '';
        
        const dots = imgs.length > 1 ? `<div class="product-img-nav">${imgs.map((_, i) => `<button type="button" class="product-img-dot ${i === 0 ? 'active' : ''}" onclick="event.stopPropagation();switchImg(${pid},${i},this)"></button>`).join('')}</div>` : '';

        return `<div class="product-card">
            ${badge}
            <button type="button" class="product-wishlist ${inW ? 'active' : ''}" onclick="toggleWishlistItem(${pid})"><i class="${inW ? 'fas' : 'far'} fa-heart"></i></button>
            <div class="product-img-container">
                <img src="${firstImg}" alt="${escapeHtml(p.name)}" id="pImg${pid}" onerror="this.src='${placeholderImage}'">
                ${dots}
            </div>
            <div class="product-info">
                <div class="product-category">${escapeHtml(catNames[p.category] || p.category)}</div>
                <h3 class="product-title">${escapeHtml(p.name)}</h3>
                <div class="product-price"><span class="price-range">${escapeHtml(p.price_range)}</span></div>
                <div class="product-actions">
                    <a href="${affiliateUrl}" target="_blank" rel="noopener noreferrer nofollow" class="btn-buy" onclick="trackClick(${pid}, '${escapeHtml(p.name)}')">
                        <i class="fas fa-external-link-alt"></i> Check Deal
                    </a>
                </div>
            </div>
        </div>`;
    }).join('');
}

function switchImg(pid, idx, dot) {
    const p = products.find(x => Number(x.id) === pid);
    if (!p || !p.images[idx]) return;
    document.getElementById('pImg' + pid).src = p.images[idx].url;
    dot.parentElement.querySelectorAll('.product-img-dot').forEach(d => d.classList.remove('active'));
    dot.classList.add('active');
}

function getFilteredProducts() {
    let f = [...products];
    const cat = document.getElementById('categoryFilter')?.value || currentCategory;
    if (cat && cat !== 'all') f = f.filter(p => p.category === cat);

    const min = parseFloat(document.getElementById('minPrice')?.value) || 0;
    const max = parseFloat(document.getElementById('maxPrice')?.value) || Infinity;
    f = f.filter(p => {
        const n = getPriceNum(p.price_range);
        return n >= min && n <= max;
    });

    const sort = document.getElementById('sortFilter')?.value || 'default';
    if (sort === 'price-low') f.sort((a, b) => getPriceNum(a.price_range) - getPriceNum(b.price_range));
    if (sort === 'price-high') f.sort((a, b) => getPriceNum(b.price_range) - getPriceNum(a.price_range));
    if (sort === 'newest') f.sort((a, b) => b.id - a.id);
    return f;
}

function getPriceNum(pr) {
    const m = (pr || '').match(/[\d,]+/g);
    if (!m) return 0;
    return parseInt(m[0].replace(/,/g, '')) || 0;
}

function applyFilters() {
    currentCategory = document.getElementById('categoryFilter')?.value || 'all';
    document.querySelectorAll('.nav-item').forEach(n => n.classList.toggle('active', (n.getAttribute('onclick') || '').includes(`'${currentCategory}'`)));
    document.getElementById('productsSectionTitle').textContent = currentCategory === 'all' ? 'All Products' : (catNames[currentCategory] || currentCategory);
    renderProducts();
}

function filterCategory(cat) {
    currentCategory = cat;
    if (document.getElementById('categoryFilter')) document.getElementById('categoryFilter').value = cat;
    applyFilters();
    document.getElementById('productsSection').scrollIntoView({behavior: 'smooth'});
}

// ===== REAL-TIME SEARCH =====
function handleSearch() {
    const q = document.getElementById('searchInput').value.trim().toLowerCase();
    const s = document.getElementById('searchSuggestions');
    if (q.length < 2) {
        s.classList.remove('show');
        return;
    }
    const m = products.filter(p => String(p.name).toLowerCase().includes(q) || (p.category || '').toLowerCase().includes(q)).slice(0, 8);
    s.innerHTML = m.length ? m.map(p => `<div class="search-suggestion-item" onclick="selectSearch(${p.id})"><i class="fas fa-search"></i><span>${escapeHtml(p.name)}</span></div>`).join('') : '<div class="search-suggestion-item"><i class="fas fa-info-circle"></i> No results</div>';
    s.classList.add('show');
}

function selectSearch(id) {
    document.getElementById('searchSuggestions').classList.remove('show');
    const p = products.find(x => x.id === id);
    if (p) {
        document.getElementById('searchInput').value = p.name;
        renderProducts([p]);
        document.getElementById('productsSectionTitle').textContent = 'Search Result';
        document.getElementById('productsSection').scrollIntoView({behavior: 'smooth'});
    }
}

function performSearch() {
    const q = document.getElementById('searchInput').value.trim().toLowerCase();
    document.getElementById('searchSuggestions').classList.remove('show');
    if (!q) {
        renderProducts();
        return;
    }
    const r = products.filter(p => p.name.toLowerCase().includes(q) || (p.category || '').toLowerCase().includes(q));
    document.getElementById('productsSectionTitle').textContent = `Search: "${q}"`;
    renderProducts(r);
    document.getElementById('productsSection').scrollIntoView({behavior: 'smooth'});
}

