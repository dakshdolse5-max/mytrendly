<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyTrendly - Best Deals & Trending Products in India</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <!-- Supabase Client CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
        :root{--primary:#ff6b35;--primary-dark:#e55a2b;--secondary:#004e89;--accent:#ffd166;--dark:#1a1a2e;--darker:#16213e;--light:#f8f9fa;--white:#fff;--gray:#6c757d;--light-gray:#e9ecef;--success:#28a745;--danger:#dc3545;--warning:#ffc107;--gradient:linear-gradient(135deg,#ff6b35,#ff8c42,#ffd166);--gradient2:linear-gradient(135deg,#004e89,#1a6fb5);--shadow:0 10px 30px rgba(0,0,0,.1);--shadow-lg:0 20px 60px rgba(0,0,0,.15);--radius:16px;--radius-sm:8px;--transition:all .3s cubic-bezier(.4,0,.2,1)}
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Poppins',sans-serif;background:var(--light);color:var(--dark);overflow-x:hidden}
        ::-webkit-scrollbar{width:8px}::-webkit-scrollbar-track{background:var(--light)}::-webkit-scrollbar-thumb{background:var(--primary);border-radius:10px}
        
        .loader-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:var(--dark);display:flex;align-items:center;justify-content:center;z-index:99999;transition:opacity .5s,visibility .5s}
        .loader-overlay.hidden{opacity:0;visibility:hidden;pointer-events:none}
        .loader{width:60px;height:60px;border:4px solid var(--light-gray);border-top:4px solid var(--primary);border-radius:50%;animation:spin .8s linear infinite}
        @keyframes spin{to{transform:rotate(360deg)}}
        
        .top-bar{background:var(--dark);color:#fff;padding:8px 0;font-size:13px}
        .top-bar .container{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
        .top-bar a{color:var(--accent);text-decoration:none}
        .top-bar-right{display:flex;gap:20px;align-items:center}
        
        .notif-wrapper{position:relative;cursor:pointer}
        .notif-badge{position:absolute;top:-8px;right:-8px;background:var(--danger);color:#fff;font-size:10px;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center}
        .notif-dropdown{position:absolute;top:100%;right:0;background:#fff;border-radius:var(--radius-sm);box-shadow:var(--shadow-lg);width:320px;max-height:400px;overflow-y:auto;display:none;z-index:1000}
        .notif-dropdown.show{display:block}
        .notif-dropdown h4{padding:15px;border-bottom:1px solid var(--light-gray);color:var(--dark)}
        .notif-item{padding:12px 15px;border-bottom:1px solid var(--light-gray);cursor:pointer;transition:var(--transition);color:var(--dark)}
        .notif-item:hover{background:var(--light)}
        .notif-item small{color:var(--gray)}
        
        .header{background:#fff;box-shadow:0 2px 20px rgba(0,0,0,.08);position:sticky;top:0;z-index:1000}
        .header .container{display:flex;align-items:center;justify-content:space-between;padding:15px 20px;gap:20px}
        .logo{font-size:28px;font-weight:800;background:var(--gradient);-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-decoration:none;white-space:nowrap}
        .brand-logo-link{display:flex;align-items:center;width:74px;height:50px;flex:0 0 74px}
        .brand-logo{display:block;width:74px;height:50px;object-fit:contain;transform:scale(1.55);transform-origin:center}
        
        .search-container{flex:1;max-width:600px;position:relative}
        .search-container input{width:100%;padding:12px 50px 12px 20px;border:2px solid var(--light-gray);border-radius:50px;font-size:15px;font-family:inherit;transition:var(--transition);background:var(--light)}
        .search-container input:focus{outline:none;border-color:var(--primary);background:#white;box-shadow:0 0 0 4px rgba(255,107,53,.1)}
        .search-btn{position:absolute;right:5px;top:50%;transform:translateY(-50%);background:var(--gradient);border:none;color:#white;width:40px;height:40px;border-radius:50%;cursor:pointer;transition:var(--transition)}
        .search-btn:hover{transform:translateY(-50%) scale(1.05)}
        .search-suggestions{position:absolute;top:100%;left:0;right:0;background:#white;border-radius:var(--radius-sm);box-shadow:var(--shadow-lg);display:none;z-index:100;max-height:300px;overflow-y:auto}
        .search-suggestions.show{display:block}
        .search-suggestion-item{padding:10px 20px;cursor:pointer;transition:var(--transition);display:flex;align-items:center;gap:10px}
        .search-suggestion-item:hover{background:var(--light)}
        
        .header-actions{display:flex;gap:15px;align-items:center}
        .header-action-btn{position:relative;background:none;border:none;font-size:22px;color:var(--dark);cursor:pointer;transition:var(--transition);padding:8px}
        .header-action-btn:hover{color:var(--primary);transform:translateY(-2px)}
        .header-action-btn .badge{position:absolute;top:0;right:0;background:var(--primary);color:#white;font-size:10px;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center}
        .mobile-menu-btn{display:none;background:none;border:none;font-size:24px;cursor:pointer;color:var(--dark)}
        
        .nav{background:var(--darker);overflow:hidden}
        .nav .container{display:flex;overflow-x:auto;scrollbar-width:none}
        .nav .container::-webkit-scrollbar{display:none}
        .nav-item{color:rgba(255,255,255,.85);text-decoration:none;padding:12px 18px;font-size:13px;font-weight:500;white-space:nowrap;transition:var(--transition);border-bottom:3px solid transparent;display:flex;align-items:center;gap:6px;cursor:pointer}
        .nav-item:hover,.nav-item.active{color:var(--accent);border-bottom-color:var(--accent);background:rgba(255,255,255,.05)}
        .container{max-width:1400px;margin:0 auto;padding:0 20px}
        
        .flash-sale-banner{background:var(--gradient);padding:20px 0;text-align:center;color:#white;position:relative;overflow:hidden}
        .flash-sale-banner::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:repeating-linear-gradient(45deg,transparent,transparent 10px,rgba(255,255,255,.03) 10px,rgba(255,255,255,.03) 20px);animation:moveStripes 20s linear infinite}
        @keyframes moveStripes{to{transform:translateX(28px)}}
        .flash-sale-content{position:relative;z-index:1}
        .flash-sale-content h2{font-size:28px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:10px}
        .flash-sale-content h2 i{animation:flash 1s infinite}
        @keyframes flash{0%,100%{opacity:1}50%{opacity:.3}}
        .countdown{display:flex;gap:10px;justify-content:center;margin-top:15px}
        .countdown-item{background:rgba(0,0,0,.3);padding:10px 18px;border-radius:var(--radius-sm);min-width:70px}
        .countdown-item .number{font-size:28px;font-weight:800;display:block}
        .countdown-item .label{font-size:11px;opacity:.8}
        
        .hero{padding:40px 0 20px}
        .hero-grid{display:grid;grid-template-columns:2fr 1fr;gap:20px}
        .hero-main{border-radius:var(--radius);overflow:hidden;position:relative;min-height:400px;background:var(--gradient2);display:flex;align-items:center;cursor:pointer}
        .hero-main-content{padding:50px;color:#white;z-index:1}
        .hero-main-content h1{font-size:42px;font-weight:800;line-height:1.2;margin-bottom:15px}
        .hero-main-content p{font-size:18px;opacity:.9;margin-bottom:25px}
        .hero-sidebar{display:flex;flex-direction:column;gap:20px}
        .hero-side-card{flex:1;border-radius:var(--radius);padding:30px;color:#white;display:flex;flex-direction:column;justify-content:center;cursor:pointer;transition:var(--transition)}
        .hero-side-card:hover{transform:translateY(-5px)}
        .hero-side-card:first-child{background:linear-gradient(135deg,#f093fb,#f5576c)}
        .hero-side-card:last-child{background:linear-gradient(135deg,#4facfe,#00f2fe)}
        .hero-side-card h3{font-size:20px;font-weight:700;margin-bottom:8px}
        .hero-side-card p{font-size:14px;opacity:.9}
        
        .partner-brands-section{background:#white;padding:25px 0;border-bottom:1px solid var(--light-gray);box-shadow:0 4px 15px rgba(0,0,0,0.02)}
        .partner-tagline{font-size:15px;font-weight:600;color:var(--dark);margin-bottom:18px;line-height:1.6;max-width:850px;margin-left:auto;margin-right:auto;text-align:center;}
        .brand-logos-container{display:flex;justify-content:center;align-items:center;gap:30px;flex-wrap:wrap;}
        .brand-logo-sim{display:flex;align-items:center;justify-content:center;padding:8px 16px;background:var(--light);border-radius:var(--radius-sm);font-weight:800;font-size:18px;letter-spacing:-0.5px;transition:var(--transition);filter:grayscale(20%);}
        .brand-logo-sim:hover{transform:translateY(-3px);filter:grayscale(0);box-shadow:var(--shadow);}
        .brand-logo-sim.amz{color:#ff9900;}
        .brand-logo-sim.flk{color:#2874f0;font-style:italic;}
        .brand-logo-sim.myn{color:#ff3f6c;}
        .brand-logo-sim.msh{color:#f43397;}
        .brand-logo-sim.cro{color:#00e4cc;}
        .brand-logo-sim.more{color:var(--gray);font-size:14px;background:transparent;}

        .section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px;flex-wrap:wrap;gap:10px}
        .section-title{font-size:26px;font-weight:700;display:flex;align-items:center;gap:10px}
        .section-title i{color:var(--primary)}
        .section-title span{background:var(--gradient);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        
        .highlights-section{padding:30px 0}
        .highlights-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
        .highlight-card{background:#white;border-radius:var(--radius);padding:30px;text-align:center;transition:var(--transition);box-shadow:var(--shadow)}
        .highlight-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg)}
        .highlight-icon{width:70px;height:70px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 15px;font-size:28px}
        .highlight-card:nth-child(1) .highlight-icon{background:#fff3e0;color:#ff9800}
        .highlight-card:nth-child(2) .highlight-icon{background:#e8f5e9;color:#4caf50}
        .highlight-card:nth-child(3) .highlight-icon{background:#e3f2fd;color:#2196f3}
        .highlight-card:nth-child(4) .highlight-icon{background:#fce4ec;color:#e91e63}
        
        .categories-section{padding:30px 0}
        .categories-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:15px}
        .category-card{background:#white;border-radius:var(--radius);padding:25px 15px;text-align:center;cursor:pointer;transition:var(--transition);box-shadow:0 2px 10px rgba(0,0,0,.05);text-decoration:none;color:var(--dark)}
        .category-card:hover{transform:translateY(-8px);box-shadow:var(--shadow)}
        .category-card i{font-size:32px;margin-bottom:10px;display:block}
        .category-card span{font-size:12px;font-weight:600;display:block}
        
        .products-section{padding:30px 0}
        .products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px}
        .product-card{background:#white;border-radius:var(--radius);overflow:hidden;transition:var(--transition);box-shadow:0 2px 15px rgba(0,0,0,.06);position:relative;display:flex;flex-direction:column}
        .product-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg)}
        .product-badge{position:absolute;top:15px;left:15px;padding:4px 12px;border-radius:50px;font-size:11px;font-weight:700;z-index:5;color:#white}
        .badge-sale{background:var(--danger)}.badge-new{background:var(--success)}.badge-hot{background:var(--primary)}.badge-deal{background:linear-gradient(135deg,#f093fb,#f5576c)}
        .product-wishlist{position:absolute;top:15px;right:15px;background:#white;border:none;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:5;box-shadow:0 2px 10px rgba(0,0,0,.1);transition:var(--transition);font-size:16px;color:var(--gray)}
        .product-wishlist:hover,.product-wishlist.active{color:var(--danger);transform:scale(1.1)}
        .product-img-container{position:relative;overflow:hidden;height:220px;background:#f5f5f5;display:flex;align-items:center;justify-content:center}
        .product-img-container img{max-width:100%;max-height:100%;object-fit:contain;padding:20px;transition:var(--transition)}
        .product-card:hover .product-img-container img{transform:scale(1.08)}
        .product-img-nav{position:absolute;bottom:10px;display:flex;gap:5px;left:50%;transform:translateX(-50%)}
        .product-img-dot{width:8px;height:8px;border-radius:50%;background:rgba(0,0,0,.2);cursor:pointer;transition:var(--transition);border:none}
        .product-img-dot.active{background:var(--primary);width:20px;border-radius:4px}
        .product-info{padding:18px;display:flex;flex-direction:column;flex-grow:1}
        .product-category{font-size:11px;color:var(--primary);font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-bottom:5px}
        .product-title{font-size:15px;font-weight:600;margin-bottom:8px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
        .product-price{margin-bottom:12px}
        .price-range{font-size:22px;font-weight:800;color:var(--primary)}
        .product-actions{display:flex;gap:10px;margin-top:auto}
        .btn-buy{flex:1;padding:12px;background:var(--gradient);color:#white;border:none;border-radius:var(--radius-sm);font-size:14px;font-weight:600;cursor:pointer;transition:var(--transition);font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none}
        .btn-buy:hover{transform:translateY(-2px);box-shadow:0 5px 20px rgba(255,107,53,.4)}
        
        .coupon-container{display:flex;align-items:center;gap:5px;margin-bottom:12px;background:#fff8f5;border:1px dashed var(--primary);border-radius:var(--radius-sm);padding:6px 10px;font-size:13px}
        .coupon-code{font-family:monospace;font-weight:700;color:var(--primary);background:rgba(255,107,53,0.1);padding:2px 6px;border-radius:4px}
        .btn-copy-coupon{background:none;border:none;color:var(--secondary);cursor:pointer;font-weight:600;margin-left:auto;display:flex;align-items:center;gap:4px;font-size:12px;transition:var(--transition)}
        .btn-copy-coupon:hover{color:var(--primary)}

        .deal-section{padding:40px 0}
        .deal-card{background:#white;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);display:grid;grid-template-columns:1fr 1fr}
        .deal-img{background:#f5f5f5;display:flex;align-items:center;justify-content:center;padding:30px;min-height:350px}
        .deal-slideshow{position:relative;width:100%;height:100%;min-height:290px;display:flex;align-items:center;justify-content:center}
        .deal-slideshow img{max-width:100%;max-height:300px;object-fit:contain;transition:opacity .25s ease}
        .deal-slide-btn{position:absolute;top:50%;transform:translateY(-50%);width:38px;height:38px;border:none;border-radius:50%;background:rgba(26,26,46,.78);color:#white;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:var(--transition);z-index:2}
        .deal-slide-btn:hover{background:var(--primary);transform:translateY(-50%) scale(1.08)}
        .deal-slide-btn.prev{left:8px}.deal-slide-btn.next{right:8px}
        .deal-slide-dots{position:absolute;bottom:8px;left:0;right:0;display:flex;justify-content:center;gap:6px}
        .deal-slide-dot{width:8px;height:8px;padding:0;border:none;border-radius:50%;background:rgba(26,26,46,.3);cursor:pointer;transition:var(--transition)}
        .deal-slide-dot.active{width:22px;border-radius:5px;background:var(--primary)}
        .deal-info{padding:40px;display:flex;flex-direction:column;justify-content:center}
        .deal-tag{display:inline-flex;align-items:center;gap:5px;background:var(--danger);color:#white;padding:6px 16px;border-radius:50px;font-size:12px;font-weight:700;width:fit-content;margin-bottom:15px;animation:pulse 2s infinite}
        @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(220,53,69,.4)}50%{box-shadow:0 0 0 10px rgba(220,53,69,0)}}
        .deal-info h2{font-size:28px;margin-bottom:10px}
        .deal-countdown{margin-bottom:20px}
        .deal-countdown p{font-size:14px;color:var(--gray);margin-bottom:10px}
        .deal-timer{display:flex;gap:10px}
        .deal-timer-item{background:var(--dark);color:#white;padding:10px 15px;border-radius:var(--radius-sm);text-align:center;min-width:60px}
        .deal-timer-item .num{font-size:22px;font-weight:800;display:block}
        .deal-timer-item .lbl{font-size:10px;opacity:.7}
        
        .review-card{background:#white;border-radius:var(--radius);padding:25px;box-shadow:0 2px 10px rgba(0,0,0,.05)}
        .review-header{display:flex;align-items:center;gap:12px;margin-bottom:12px}
        .review-avatar{width:45px;height:45px;border-radius:50%;background:var(--gradient);display:flex;align-items:center;justify-content:center;color:#white;font-weight:700}
        .review-author{font-weight:600;font-size:14px}
        .review-text{font-size:14px;line-height:1.6;color:var(--gray)}
        
        .newsletter-section{padding:60px 0;margin:30px 0}
        .newsletter-card{background:var(--gradient2);border-radius:var(--radius);padding:60px;text-align:center;color:#white;position:relative;overflow:hidden}
        .newsletter-card::before{content:'';position:absolute;top:-50%;right:-20%;width:400px;height:400px;background:rgba(255,255,255,.05);border-radius:50%}
        .newsletter-card h2{font-size:32px;margin-bottom:10px;position:relative}
        .newsletter-card p{font-size:16px;opacity:.9;margin-bottom:30px;position:relative}
        .newsletter-form{display:flex;max-width:500px;margin:0 auto;gap:10px;position:relative}
        .newsletter-form input{flex:1;padding:15px 25px;border:none;border-radius:50px;font-size:15px;font-family:inherit}
        .newsletter-form input:focus{outline:none}
        .newsletter-form button{padding:15px 30px;background:var(--primary);color:#white;border:none;border-radius:50px;cursor:pointer;font-weight:600;font-family:inherit;transition:var(--transition)}
        .newsletter-form button:hover{background:var(--primary-dark)}
        
        .footer{background:var(--dark);color:rgba(255,255,255,.7);padding:60px 0 20px}
        .footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:40px}
        .footer-brand .logo{font-size:32px;display:inline-block;margin-bottom:15px}
        .footer-brand-logo{display:block;width:110px;height:72px;object-fit:contain;background:#white;border-radius:var(--radius-sm);padding:5px;margin-bottom:15px}
        .footer-brand p{line-height:1.7;font-size:14px}
        .footer-col h4{color:#white;margin-bottom:20px;font-size:16px}
        .footer-col a{display:block;color:rgba(255,255,255,.6);text-decoration:none;padding:5px 0;font-size:14px;transition:var(--transition);cursor:pointer}
        .footer-col a:hover{color:var(--accent);padding-left:5px}
        .footer-social{display:flex;gap:12px;margin-top:20px}
        .footer-social a{width:40px;height:40px;background:rgba(255,255,255,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#white;transition:var(--transition)}
        .footer-social a:hover{background:var(--primary);transform:translateY(-3px)}
        .footer-bottom{border-top:1px solid rgba(255,255,255,.1);padding-top:20px;text-align:center;font-size:13px}
        
        .wishlist-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);z-index:9998;display:none}
        .wishlist-overlay.show{display:block}
        .wishlist-sidebar{position:fixed;top:0;right:-420px;width:400px;height:100%;background:#white;z-index:9999;transition:var(--transition);box-shadow:var(--shadow-lg);display:flex;flex-direction:column}
        .wishlist-sidebar.show{right:0}
        .wishlist-header{padding:20px;border-bottom:1px solid var(--light-gray);display:flex;justify-content:space-between;align-items:center}
        .wishlist-header h3{font-size:18px}
        .wishlist-close{background:none;border:none;font-size:24px;cursor:pointer;color:var(--gray)}
        .wishlist-items{flex:1;overflow-y:auto;padding:20px}
        .wishlist-item{display:flex;gap:15px;padding:15px;border-bottom:1px solid var(--light-gray);align-items:center}
        .wishlist-item img{width:60px;height:60px;object-fit:contain;border-radius:8px;background:#f5f5f5;padding:5px}
        .wishlist-item-info{flex:1}
        .wishlist-item-info h4{font-size:13px;margin-bottom:5px}
        .wishlist-item-info .price{color:var(--primary);font-weight:700}
        .wishlist-item-remove{background:none;border:none;color:var(--danger);cursor:pointer;font-size:16px}
        .wishlist-empty{text-align:center;padding:60px 20px;color:var(--gray)}
        .wishlist-empty i{font-size:50px;margin-bottom:15px;display:block}
        
        .mobile-nav-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);z-index:9998;display:none}
        .mobile-nav-overlay.show{display:block}
        .mobile-nav{position:fixed;top:0;left:-320px;width:300px;height:100%;background:#white;z-index:9999;transition:var(--transition);overflow-y:auto}
        .mobile-nav.show{left:0}
        .mobile-nav-header{padding:20px;background:var(--gradient);color:#white}
        .mobile-nav-item{display:flex;align-items:center;gap:12px;padding:15px 20px;border-bottom:1px solid var(--light-gray);color:var(--dark);text-decoration:none;font-size:14px;font-weight:500;transition:var(--transition);cursor:pointer}
        .mobile-nav-item:hover{background:var(--light);color:var(--primary)}
        .mobile-nav-item i{width:20px;text-align:center}
        
