function downloadSubscribersCsv() {
    if(!subscribers.length) {
        showToast('Subscriber list is empty', 'info');
        return;
    }
    const rows = [['No', 'Email', 'Date'], ...subscribers.map((s, idx) => [idx+1, s.email, s.date])];
    const csv = '\uFEFF' + rows.map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `mytrendly_subscribers_${new Date().toISOString().slice(0, 10)}.csv`;
    link.click();
    showToast('CSV downloaded!', 'success');
}

