async function saveEditTrending() {
    const id = document.getElementById('editTrendId').value;
    const title = document.getElementById('editTrendTitle').value.trim();
    const type = document.getElementById('editTrendType').value;
    const rating = parseFloat(document.getElementById('editTrendRating').value) || 0;
    const excerpt = document.getElementById('editTrendExcerpt').value.trim();
    const content = document.getElementById('editTrendContent').value.trim();
    const affiliate_url = document.getElementById('editTrendAffiliateUrl').value.trim();
    const affiliate_btn_text = document.getElementById('editTrendAffiliateBtnText').value.trim();
    const fileInput = document.getElementById('editTrendImageFiles');

    showToast('Saving...', 'info');
    let imgs = [];
    document.querySelectorAll('#editTrendImageUrls .img-url-input').forEach(input => {
        if(input.value.trim()) imgs.push(input.value.trim());
    });

    if(fileInput && fileInput.files.length) {
        for(let i=0; i<fileInput.files.length; i++) {
            const url = await uploadToSupabaseStorage(fileInput.files[i], 'articles');
            if(url) imgs.push(url);
        }
    }

    let inlineDeals = [];
    document.querySelectorAll('#editTrendInlineDealsContainer .image-url-row').forEach(row => {
        const text = row.querySelector('.inline-txt').value.trim();
        const url = row.querySelector('.inline-url').value.trim();
        if(text && url) inlineDeals.push({ text, url });
    });

    const { error } = await _supabase.from('trending_posts').update({
        title, type, rating, excerpt, content, affiliate_url, affiliate_btn_text, images: imgs, inline_deals: inlineDeals
    }).eq('id', id);

    if(error) showToast('Update failed: ' + error.message, 'error');
    else {
        showToast('Trending Article Updated!', 'success');
        closeEditTrendingModal();
        await syncFromSupabase();
    }
}

